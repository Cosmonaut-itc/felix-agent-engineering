<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cosmonaut.pao-mini-vigilante</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>__HOME__/bin/pao-mini-vigilante.py</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pao-mini-vigilante.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pao-mini-vigilante.log</string>
</dict>
</plist>
