#!/usr/bin/env python3
"""Entrega durable, planificación en sombra y tick de repos inscritos activos."""
import argparse
from contextlib import ExitStack
from datetime import datetime, timezone
import importlib
import json
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import sys
import time
import uuid

ARRANQUE = time.monotonic()

# Script location is trusted, independent of cwd, including python -I invocations.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from cache_github import CacheGitHub
from dominio import (Admitido, Decision, Entrada, Entrega, Estado, Observacion,
                     admision_entrada, datos, paso)
from inscripcion import activacion, modo
from ledger import (CandadoOcupado, Ledger, candado_programa, directorio_estado, filas_medicion,
                    lectura_medicion)
from medicion import decision_json, instante_iso, medir
from observador import ERRORES_LECTURA, GitHubGit, LimiteGitHub, configuracion, sha
from sombra import paso_sombra


def repositorio(valor):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", valor):
        raise argparse.ArgumentTypeError("repo debe ser owner/repo")
    return valor


def head(valor):
    if not sha(valor):
        raise argparse.ArgumentTypeError("head debe ser SHA40 hexadecimal minúsculo")
    return valor


def positivo(valor):
    numero = int(valor)
    if numero <= 0:
        raise argparse.ArgumentTypeError("pr debe ser positivo")
    return numero


def motivo(valor):
    if not valor.strip():
        raise argparse.ArgumentTypeError("motivo no puede estar vacío")
    return valor


def texto_iso(valor):
    instante_iso(valor)
    return valor


def parser():
    cli = argparse.ArgumentParser(description=__doc__)
    comandos = cli.add_subparsers(dest="comando", required=True)
    entregar = comandos.add_parser("entregar")
    entregar.add_argument("--repo", required=True, type=repositorio)
    entregar.add_argument("--pr", required=True, type=positivo)
    entregar.add_argument("--head", required=True, type=head)
    entregar.add_argument("--apto", required=True)
    entregar.add_argument("--dirigida", required=True)
    entregar.add_argument("--config", help="JSON privado por repo para observar la entrega en sombra")
    estado = comandos.add_parser("estado")
    estado.add_argument("--repo", required=True, type=repositorio)
    estado.add_argument("--juicio", action="store_true")
    juicio = comandos.add_parser("juicio")
    juicio.add_argument("--repo", required=True, type=repositorio)
    juicio.add_argument("--tren")
    juicio.add_argument("--decision", required=True,
                        choices=("absolver", "expulsar", "reanudar", "abortar"))
    juicio.add_argument("--pr", type=positivo)
    juicio.add_argument("--motivo", required=True, type=motivo)
    pausa = comandos.add_parser("pausa")
    pausa.add_argument("--repo", required=True, type=repositorio)
    pausa.add_argument("--levantar", action="store_true")
    pausa.add_argument("--motivo", required=True, type=motivo)
    tick = comandos.add_parser("tick")
    tick.add_argument("--repo", required=True, type=repositorio)
    tick.add_argument("--seco", action="store_true")
    tick.add_argument("--config", help="JSON privado por repo; por defecto state/config.json")
    medicion = comandos.add_parser("medir")
    medicion.add_argument("--repo", required=True, type=repositorio)
    medicion.add_argument("--desde", required=True, type=instante_iso)
    medicion.add_argument("--hasta", required=True, type=instante_iso)
    latencia = comandos.add_parser("latencia", help="medir horas de espera y sus causas")
    latencia.add_argument("--repo", required=True, type=repositorio)
    latencia.add_argument("--desde", required=True, type=instante_iso)
    latencia.add_argument("--hasta", type=instante_iso)
    latencia.add_argument("--prs", type=Path, help="JSON de gh pr list con number,mergedAt,state")
    fases = comandos.add_parser("fases")
    fases.add_argument("--repo", required=True, type=repositorio)
    fases.add_argument("--desde", required=True, type=texto_iso)
    fases.add_argument("--hasta", required=True, type=texto_iso)
    panel = comandos.add_parser("panel", help="proyectar el ledger como tren-host@1")
    alcance = panel.add_mutually_exclusive_group(required=True)
    alcance.add_argument("--repo", type=repositorio)
    alcance.add_argument("--todos", action="store_true")
    candado = comandos.add_parser("candado")
    candado.add_argument("orden", nargs="+", help="comando que corre sin ningún tick activo")
    return cli


def ejecutar(args, observador=None, ahora=None, git=None, adaptador=None, frontera=None,
             escritor=None, instalando=False):
    if args.comando in ("juicio", "pausa") or args.comando == "tick" and not args.seco:
        inscripcion = activacion(args.repo)
        if inscripcion != "activo":
            mensaje = ("tick activo requiere inscripción activa" if args.comando == "tick" else
                       "comando activo requiere inscripción activa")
            return 2, {"error": mensaje,
                       "inscripcion": inscripcion or "no-inscrito"}
    if instalando:
        return 0, {"omitido": "instalacion-en-curso"}
    if args.comando == "medir":
        requests, events = filas_medicion(args.repo)
        return 0, medir(requests, events, args.repo, args.desde, args.hasta)
    if args.comando == "latencia":
        from latencia import medir_latencia
        from ledger import filas_latencia
        hasta = args.hasta if args.hasta is not None else (time.time() if ahora is None else ahora)
        prs = None
        if args.prs is not None:
            with args.prs.open(encoding="utf-8") as archivo:
                prs = json.load(archivo)
            if not isinstance(prs, list):
                raise ValueError("--prs requiere un arreglo JSON")
        with filas_latencia(args.repo, hasta) as filas:
            return 0, medir_latencia(*filas, args.repo, args.desde, hasta, prs)
    if args.comando == "fases":
        from fases import medir_fases
        from ledger import filas_fases
        return 0, medir_fases(*filas_fases(args.repo), args.repo, args.desde, args.hasta)
    if args.comando == "panel":
        from panel import publicar
        return 0, publicar(args.repo, ahora)
    if args.comando == "candado":
        # Sin ledger no hay tick que excluir, y este comando no lo crea.
        if not (directorio_estado() / "ledger.sqlite3").exists():
            return 2, {"error": "ledger no disponible"}
        with candado_programa(exclusivo=True) as libre:
            if not libre:
                return 75, {"candado": "ocupado"}
            codigo = subprocess.run(args.orden).returncode
            time.sleep(GRACIA_INSTALACION_S)
        return codigo, {"candado": "tomado", "codigo": codigo}
    plazo = plazo_candado() if args.comando in ("juicio", "pausa") else None
    if args.comando in ("juicio", "pausa") and plazo is None:
        return 2, {"error": "PAO_TREN_PLAZO_CANDADO_S inválido: segundos, número no negativo"}
    ledger = Ledger()
    recursos = ExitStack()
    ahora = time.time() if ahora is None else ahora
    try:
        if args.comando in ("juicio", "pausa"):
            from juicios import error_decision
            with ledger.candado(args.repo, plazo, lambda: print(
                    f"{TICK_EN_CURSO}: espero el candado hasta {plazo:g} s", file=sys.stderr, flush=True)):
                if activacion(args.repo) != "activo":
                    return 2, {"error": "comando activo requiere inscripción activa"}
                estado = ledger.estado(args.repo, operativo=True)
                decision = Decision(uuid.uuid4().hex, args.repo,
                    args.tren if args.comando == "juicio" else None,
                    args.decision if args.comando == "juicio" else
                    "levantar" if args.levantar else "pausar",
                    args.pr if args.comando == "juicio" else None,
                    args.motivo, ahora, ledger.pausa_id(args.repo, estado), estado.pausa)
                error = error_decision(estado, decision, decision.pausa_id)
                if error:
                    return 2, {"error": error}
                if ledger.siguiente_decision(args.repo) is not None:
                    return 2, {"error": "decision-pendiente"}
                ledger.registrar_decision(decision)
                if frontera:
                    frontera("decision-guardada", None)
                return 0, {"decision": datos(decision), "estado": "pendiente"}
        if args.comando == "entregar":
            # Freeze relative local references, so subsequent ticks can have another cwd.
            refs = [v if v.startswith("https://") else str(Path(v).resolve())
                    for v in (args.apto, args.dirigida)]
            entrega = Entrega(args.repo, args.pr, args.head, *refs)
            if modo(args.repo) != "sombra":
                recibo = ledger.entregar(entrega, ahora)
                return 0, {"recibo": recibo, "estado": "custodia"}
            with ledger.candado(args.repo):
                existente = ledger.db.execute("SELECT payload FROM requests WHERE recibo=?",
                                             (entrega.recibo,)).fetchone()
                if existente:
                    recibo = ledger.entregar(entrega, ahora)
                    return 0, {"recibo": recibo, "estado": "custodia"}
                estado = Estado(args.repo, (Entrada(entrega, ahora),))
                try:
                    if observador is None:
                        ruta = args.config or ledger.directorio / "config.json"
                        observador = GitHubGit(configuracion(ruta, args.repo), sombra=True,
                            cache=recursos.enter_context(CacheGitHub(ledger.directorio)))
                    observacion = observador.observar(estado, ahora)
                except (*ERRORES_LECTURA, LimiteGitHub):
                    # Custodia durable aun sin observación; no inventa admisión.
                    observacion = Observacion(ahora, "", ())
                vistas = {v.recibo or str(v.pr): v for v in observacion.prs}
                decision = admision_entrada(estado.entradas[0], vistas, observacion)
                vista = vistas.get(entrega.recibo, vistas.get(str(entrega.pr)))
                entrada = Entrada(entrega, ahora, decision,
                                  ahora if isinstance(decision, Admitido) else None,
                                  bool(vista and vista.requiere_solo))
                recibo = ledger.entregar(entrega, ahora, entrada)
                return 0, {"recibo": recibo, "estado": "custodia",
                           "admision": decision_json(entrada.admision)}
        if args.comando == "estado":
            from operativo import resumen_outbox
            from preaterrizaje import resumen_cancelaciones
            # Snapshot SQLite consistente, legible incluso con IO bajo flock.
            with ledger.transaccion(escritura=False):
                resultado = {"estado": datos(ledger.estado(args.repo)),
                           "sombra": datos(ledger.estado(args.repo, sombra=True,
                                                         doble_camino=modo(args.repo) == "sombra")),
                           "outbox": resumen_outbox(ledger, args.repo),
                           "cancelaciones_pre_aterrizaje": resumen_cancelaciones(ledger, args.repo),
                           "eventos": ledger.ultimos_eventos(args.repo)}
                if args.juicio:
                    from juicios import expediente
                    resultado["juicio"] = expediente(ledger, args.repo)
                return 0, resultado
        # El tick en seco no espera: durante la suite la admisión se lee con `estado`.
        candado = ledger.candado(args.repo, 0) if args.seco else ledger.candado(args.repo)
        with candado:
            if not args.seco:
                # Releer tras esperar el flock: pudieron retirar la inscripción.
                if activacion(args.repo) != "activo":
                    return 2, {"error": "tick activo requiere inscripción activa"}
                from adaptadores import seleccionar
                from adaptadores.jale import Jale
                from git_ops import GitTren, identidad_commits
                from operativo import tick
                if observador is None or git is None:
                    ruta = args.config or ledger.directorio / "config.json"
                    config = configuracion(ruta, args.repo)
                    remoto = config.get("remoto")
                    if not isinstance(remoto, str) or not remoto:
                        raise ValueError("tick activo requiere remoto explícito")
                    git = git if git is not None else GitTren(
                        remoto, identidad=identidad_commits(config))
                    # Admisión y armado comparten el bare del tren: el tick
                    # siguiente ve el C aterrizado sin sincronizar config["git"].
                    PARALELAS_TICK_ACTIVO = 4
                    observador = observador or GitHubGit(config, activo=True, almacen=git,
                        paralelas=PARALELAS_TICK_ACTIVO,
                        cache=recursos.enter_context(CacheGitHub(ledger.directorio)))
                    if adaptador is None:
                        adaptador = seleccionar(config, git)
                if isinstance(adaptador, Jale):
                    adaptador.limite_cancelacion = getattr(args, "limite_cancelacion", None)
                return 0, tick(ledger, args.repo, observador, ahora, git, adaptador, frontera,
                               escritor)
            doble_camino = modo(args.repo) == "sombra"
            estado = ledger.estado(args.repo, sombra=True, doble_camino=doble_camino)
            if observador is None:
                ruta = args.config or ledger.directorio / "config.json"
                observador = GitHubGit(configuracion(ruta, args.repo), sombra=doble_camino,
                    cache=recursos.enter_context(CacheGitHub(ledger.directorio)))
            observacion = observador.observar(estado, ahora)
            reductor = paso_sombra if doble_camino else paso
            nuevo, efectos = reductor(estado, observacion)
            # La simulación conserva sus eventos históricos: las señales de
            # incorporación/aterrizaje sólo pertenecen al outbox operativo.
            from feedback import STATUS_SOLO
            efectos = tuple(e for e in efectos if e.tipo not in STATUS_SOLO)
            plan = ledger.sombra(nuevo, efectos, ahora, doble_camino=doble_camino)
            return 0, {"modo": "sombra", "plan": plan}
    except CandadoOcupado:
        detalle = (f"lee la admisión con `pao-tren estado --repo {args.repo}`" if args.comando == "tick"
                   else f"el candado siguió tomado {plazo:g} s")
        # Línea fija para quien reintenta sobre 75: nada quedó registrado.
        print(f"{TICK_EN_CURSO}; no se registró nada ({detalle})", file=sys.stderr, flush=True)
        return 75, {"candado": "ocupado", "registrado": False}
    finally:
        recursos.close()
        ledger.close()


TICK_EN_CURSO = "pao-tren: tick en curso"
# Un tick sin suite tarda de 20 a 60 s; la suite retiene el candado de 25 a 90 min.
PLAZO_CANDADO_S = 90


def plazo_candado():
    """Plazo de juicio y pausa: PAO_TREN_PLAZO_CANDADO_S o el de defecto; None si es inválido."""
    valor = os.environ.get("PAO_TREN_PLAZO_CANDADO_S")
    if valor is None:
        return PLAZO_CANDADO_S
    try:
        plazo = float(valor)
    except ValueError:
        return None
    return plazo if 0 <= plazo < float("inf") else None


ENCADENADOS = 8
CUOTA_MINIMA = 1000
PLAZO_ESPERA_CI_S = 100
# Reserva 10 s del intervalo de launchd para cerrar el paso y sus efectos.
PLAZO_TICK_CANCELACION_S = 110
INTERVALO_SONDEO_CI_S = 20
# Quien instala conserva el candado este tiempo: cubre el arranque de un proceso.
GRACIA_INSTALACION_S = 5
PEREZOSOS = ("adaptadores.hasito", "adaptadores.jale", "atribucion", "feedback", "git_ops",
             "juicios", "operador", "operativo", "preaterrizaje")


def huella(repo):
    """Lo que un tick puede hacer avanzar: la pausa, la fase de cada tren y cada efecto pendiente."""
    try:
        # Leer la huella no crea el ledger: un repo sin inscripción activa no lo abre.
        if not (directorio_estado() / "ledger.sqlite3").exists():
            return None
        ledger = Ledger()
        try:
            with ledger.transaccion(escritura=False):
                estado = ledger.estado(repo, operativo=True)
                return (estado.pausa is None,
                        tuple((t.id, type(t.fase).__name__) for t in estado.trenes),
                        # Un efecto fallido sigue pendiente: su reintento no es avance.
                        tuple((f["clave"], "pendiente" if f["estado"] == "fallido" else f["estado"])
                              for f in ledger.outbox(repo)))
        finally:
            ledger.close()
    except (OSError, ValueError, KeyError, TypeError, sqlite3.Error):
        return None


def programa():
    """Identidad del programa instalado; None si no puede leerse completo."""
    raiz = Path(__file__).resolve().parent
    try:
        return tuple(sorted((str(p), p.stat().st_mtime_ns, p.stat().st_size)
                            for p in (Path(__file__).resolve(), *raiz.rglob("*.py"))
                            if "tests" not in p.relative_to(raiz).parts))
    except OSError:
        return None


def cuota(ejecutar=subprocess.run):
    """La cadena no gasta la cuota de GitHub que comparten las demás sesiones."""
    try:
        salida = ejecutar(["gh", "api", "rate_limit", "--jq", ".resources.core.remaining"],
                          check=True, capture_output=True, text=True, timeout=10).stdout
        return int(salida) >= CUOTA_MINIMA
    except (OSError, ValueError, subprocess.SubprocessError):
        return False


def estado_para_espera(repo):
    with lectura_medicion() as db:
        # El constructor abre una transacción de escritura para preparar el esquema.
        ledger = Ledger.__new__(Ledger)
        ledger.db = db
        estado = ledger.estado(repo, operativo=True)
        if estado.pausa is None and ledger.siguiente_decision(repo) is None:
            return estado


def esperar_ci(repo, limite, leer, sondear, vigente, dormir, reloj):
    def lectura():
        if reloj() >= limite or not vigente():
            return None, None
        try:
            estado = leer(repo)
        except (*ERRORES_LECTURA, sqlite3.Error):
            return None, None
        tren = GitHubGit.tren_en_ci(estado) if estado is not None and estado.pausa is None else None
        return estado, (tren.id, tren.fase.candidato.C, tren.fase.solicitud) if tren else None

    _, candidato = lectura()
    while candidato is not None and reloj() + INTERVALO_SONDEO_CI_S <= limite:
        dormir(INTERVALO_SONDEO_CI_S)
        estado, despues = lectura()
        if despues != candidato:
            return False
        try:
            resultado = sondear(estado)
        except ERRORES_LECTURA:
            continue
        if resultado is not None and resultado[1].estado != "pendiente":
            # El sondeo tarda: una pausa o una decisión pudo llegar mientras tanto.
            return lectura()[1] == candidato and reloj() < limite
    return False


def encadenar(un_tick, huella, seguir, tope=ENCADENADOS, esperar=lambda: False):
    """Repite el tick si avanzó el carril o si el CI del candidato ya respondió."""
    antes = huella()
    tras_espera = False
    for restantes in range(tope - 1, -1, -1):
        codigo, resultado = un_tick()
        yield codigo, resultado
        if codigo != 0 or not restantes:
            return
        despues = huella()
        if antes is None or despues is None:
            return
        if despues == antes:
            if tras_espera or not esperar():
                return
            tras_espera = True
        else:
            tras_espera = False
        if not seguir():
            return
        antes = despues


def error_entrada(exc):
    # Do not echo subprocess argv/output or private config/evidence paths.
    return 2, {"error": "entrada u observación inválida", "clase": type(exc).__name__}


def error_limite(exc):
    reinicio = datetime.fromtimestamp(exc.reinicio, timezone.utc).isoformat()
    return 75, {"error": "limite-github", "recurso": exc.recurso, "reinicio": reinicio}


def intento(args, instalando=False):
    try:
        return ejecutar(args, instalando=instalando)
    except LimiteGitHub as exc:
        return error_limite(exc)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as exc:
        return error_entrada(exc)
    except sqlite3.Error:
        return 2, {"error": "ledger no disponible"}


def ticks(args):
    if args.seco:
        yield intento(args)
        return
    inicial = programa()
    # Instalar durante un tick no debe mezclar versiones a medio paso.
    for modulo in PEREZOSOS:
        importlib.import_module(modulo)
    limite = ARRANQUE + PLAZO_ESPERA_CI_S
    args.limite_cancelacion = ARRANQUE + PLAZO_TICK_CANCELACION_S

    def vigente():
        return inicial is not None and programa() == inicial

    def seguir():
        # La cuota tarda; el programa se compara justo antes del siguiente tick.
        return inicial is not None and cuota() and vigente()

    def gh(argv, *, timeout, **opciones):
        restante = limite - time.monotonic()
        if restante <= 0:
            raise subprocess.TimeoutExpired(argv, timeout)
        return subprocess.run(argv, timeout=min(timeout, restante), **opciones)

    def esperar():
        if time.monotonic() + INTERVALO_SONDEO_CI_S > limite or not seguir():
            return False
        directorio = directorio_estado()
        with CacheGitHub(directorio) as cache:
            try:
                ruta = args.config or directorio / "config.json"
                observador = GitHubGit(configuracion(ruta, args.repo), ejecutar=gh, activo=True,
                                        cache=cache)
            except ERRORES_LECTURA:
                return False
            return esperar_ci(args.repo, limite, estado_para_espera, observador.ci_candidato,
                              vigente, time.sleep, time.monotonic)

    try:
        yield from encadenar(lambda: intento(args), lambda: huella(args.repo), seguir,
                              esperar=esperar)
    except LimiteGitHub as exc:
        yield error_limite(exc)


def emitir(pasos):
    codigo = 2
    for codigo, resultado in pasos:
        print(json.dumps(resultado, sort_keys=True, ensure_ascii=False), flush=True)
    return codigo


def main():
    args = parser().parse_args()
    if args.comando != "tick":
        return emitir([intento(args)])
    with ExitStack() as pila:
        try:
            # El proceso de un tick conserva este candado hasta salir: instalar lo excluye entero.
            libre = pila.enter_context(candado_programa(exclusivo=False))
        except OSError as exc:
            # Sin el candado no corre ningún tick.
            return emitir([error_entrada(exc)])
        return emitir(ticks(args) if libre else [intento(args, instalando=True)])


if __name__ == "__main__":
    sys.exit(main())
