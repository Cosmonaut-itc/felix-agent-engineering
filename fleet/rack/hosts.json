[
  {
    "id": "mini",
    "name": "Mac Mini",
    "transport": "local",
    "argv": [
      "/usr/bin/python3",
      "-I",
      "{rack_dir}/snapshot.py",
      "--host",
      "mini"
    ],
    "actions": {
      "transport": "local",
      "reason": null,
      "controllers": {
        "remote-run": "~/.local/lib/remote-run/run-control.py"
      }
    }
  },
  {
    "id": "desk",
    "name": "Felix DESKTOP · WSL",
    "transport": "ssh",
    "argv": [
      "/usr/bin/ssh",
      "-T",
      "-o",
      "BatchMode=yes",
      "-o",
      "ConnectTimeout=10",
      "-o",
      "IdentitiesOnly=yes",
      "-i",
      "~/.ssh/id_ed25519_pao_rack",
      "Felix@felix-desktop"
    ],
    "actions": {
      "transport": "ssh",
      "reason": null,
      "controllers": {
        "remote-run": "~/.local/lib/remote-run/run-control.py",
        "jale": "~/.local/lib/jale/pueue-control.py"
      },
      "argv": [
        "/usr/bin/ssh",
        "-F",
        "/dev/null",
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "IdentityAgent=none",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=~/.ssh/known_hosts",
        "-o",
        "ClearAllForwardings=yes",
        "-o",
        "PermitLocalCommand=no",
        "-o",
        "ControlMaster=no",
        "-o",
        "ControlPath=none",
        "-i",
        "~/.ssh/id_ed25519_pao_rack_accion",
        "Felix@felix-desktop"
      ]
    }
  }
]
