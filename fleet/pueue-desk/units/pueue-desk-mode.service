[Unit]
Description=Aplicar cuotas vigentes UTC del desk
Requisite=pueued.service
After=pueued.service
ConditionPathExists=!@HOME@/.local/state/pao/pueue-desk/maintenance

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I @HOME@/.local/lib/pao-pueue-desk/control.py aplicar
Restart=on-failure
RestartSec=30
