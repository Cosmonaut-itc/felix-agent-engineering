[Unit]
Description=Pueue del desk por proyecto
# Cuotas/sensores fallidos retienen admisión; no reinician el daemon.
Wants=pueue-desk-mode.service pueue-desk-guard.service
StartLimitIntervalSec=0
ConditionPathExists=!@HOME@/.local/state/pao/pueue-desk/maintenance

[Service]
ExecStartPre=/usr/bin/python3 -I @HOME@/.local/lib/pao-pueue-desk/control.py preparar --host desk
ExecStart=@HOME@/.local/bin/pueued
ExecStop=-/usr/bin/python3 -I @HOME@/.local/lib/pao-pueue-desk/control.py parada --host desk
WorkingDirectory=@HOME@
StandardOutput=null
StandardError=journal
Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=default.target
