#!/usr/bin/python3 -IB
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys


PLAZO_ALINEAR = 2 * 60 * 60
PLAZO_GIT = 120


class FalloGit(Exception):
    pass


def ocultar_ids(salida):
    return re.sub(r'bx_[a-z0-9]+', '[id de Boat]', salida)


def git(repo, *args):
    try:
        proceso = subprocess.run(
            ['git', '-C', str(repo), *args], check=True, stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=PLAZO_GIT,
            env={**os.environ, 'GIT_TERMINAL_PROMPT': '0'}, encoding='utf-8', errors='replace',
        )
    except (subprocess.SubprocessError, OSError) as error:
        salida = getattr(error, 'output', None)
        if isinstance(salida, bytes):
            salida = salida.decode('utf-8', errors='replace')
        detalle = re.sub(r'(https?://)[^/\s@]+@', r'\1[credenciales]@', salida or '')
        detalle = f'{type(error).__name__}\n{detalle}'.rstrip()
        raise FalloGit(f'git {args[0]}: {detalle}') from None
    return proceso.stdout.rstrip('\n')


def verificar_limpieza(worktree):
    if git(worktree, 'status', '--porcelain=v1', '--untracked-files=all', '--ignore-submodules=none'):
        raise FalloGit('El worktree de Jale está sucio. Revisa sus cambios.')


def preparar_worktree(repo, worktree, sha):
    if not (worktree / '.git').exists():
        git(repo, 'worktree', 'add', '--detach', str(worktree), sha)
        verificar_limpieza(worktree)
        return

    comun = ('rev-parse', '--path-format=absolute', '--git-common-dir')
    if (worktree == repo or not (worktree / '.git').is_file()
            or git(worktree, *comun) != git(repo, *comun)):
        raise FalloGit('La ruta configurada debe ser un worktree vinculado al clon de Jale.')
    verificar_limpieza(worktree)
    if git(worktree, 'rev-parse', '--abbrev-ref', 'HEAD') != 'HEAD':
        raise FalloGit('El worktree de Jale tiene una rama activa. Usa un worktree con HEAD separado.')
    if git(worktree, 'rev-parse', 'HEAD') != sha:
        git(worktree, 'checkout', '--detach', '--no-overwrite-ignore', sha)
        verificar_limpieza(worktree)


def alinear(worktree):
    try:
        proceso = subprocess.Popen(
            [sys.executable, '-I', '-B', 'scripts/test-hosts/boat-pilot.py', 'alinear'],
            cwd=worktree, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            start_new_session=True, encoding='utf-8', errors='replace',
        )
    except OSError as error:
        return 'inicio', str(error), 'No se pudo iniciar el comando alinear.'

    with proceso:
        try:
            salida, _ = proceso.communicate(timeout=PLAZO_ALINEAR)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proceso.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            salida, _ = proceso.communicate()
            return 'plazo', salida, 'El comando alinear superó el plazo de dos horas.'

    codigo = proceso.returncode
    if codigo == 0:
        return codigo, salida, ''
    if codigo == 1:
        fallos = '\n'.join(linea for linea in salida.splitlines() if 'fallo:' in linea)
        return codigo, salida, fallos or 'El comando alinear salió con código 1.'
    return codigo, salida, f'El comando alinear salió con código {codigo}.'


def notificar(mensaje):
    script = 'on run argv\ndisplay notification (item 1 of argv) with title "Boat: alinear Jale"\nend run'
    subprocess.run(
        [os.environ.get('ALINEAR_JALE_OSASCRIPT', '/usr/bin/osascript'), '-e', script, mensaje],
        check=True, timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def guardar_estado(ruta, estado):
    temporal = ruta.with_suffix('.nuevo')
    temporal.write_text(json.dumps(estado, ensure_ascii=False) + '\n', encoding='utf-8')
    temporal.replace(ruta)


def pasada(directorio, repo, worktree):
    ruta = directorio / 'estado.json'
    origen = {'repo': str(repo), 'worktree': str(worktree)}
    try:
        anterior = json.loads(ruta.read_text(encoding='utf-8'))
    except (FileNotFoundError, ValueError):
        anterior = {}
    if not isinstance(anterior, dict) or anterior.get('origen') != origen:
        anterior = {}

    sha = anterior.get('sha')
    try:
        git(repo, 'fetch', '-q', '--refmap=+refs/heads/main:refs/remotes/origin/main', 'origin', 'main')
        sha = git(repo, 'rev-parse', '--verify', 'refs/remotes/origin/main^{commit}')
        preparar_worktree(repo, worktree, sha)
    except FalloGit as error:
        etapa, codigo, salida, aviso = 'git', 2, str(error), str(error).splitlines()[0]
    else:
        if anterior.get('sha') == sha and anterior.get('codigo') == 0:
            return 0
        etapa = 'alinear'
        codigo, salida, aviso = alinear(worktree)

    salida = ocultar_ids(salida)
    ahora = datetime.now(timezone.utc)
    log = directorio / f'{etapa}-{ahora:%Y%m%dT%H%M%S.%fZ}.log'
    log.write_text(salida, encoding='utf-8')
    avisados = anterior.get('avisados', [])
    estado = dict(origen=origen, sha=sha, etapa=etapa, codigo=codigo, salida=salida,
                  hora=ahora.isoformat(), log=log.name, avisados=avisados)
    guardar_estado(ruta, estado)

    if codigo == 0:
        return 0
    huella = hashlib.sha256(json.dumps([sha, etapa, codigo, salida]).encode()).hexdigest()
    if huella not in avisados:
        try:
            notificar(ocultar_ids(f'{aviso}\nLog: {log.name}'))
        except (OSError, subprocess.SubprocessError):
            print('alinear-jale: no se pudo enviar la notificación de macOS', file=sys.stderr)
        else:
            avisados.append(huella)
            guardar_estado(ruta, estado)
    return 1 if codigo == 1 else 2


def main():
    home = Path.home()
    config = Path(os.environ.get('XDG_CONFIG_HOME') or home / '.config') / 'boat-pool/alinear-jale.json'
    try:
        ajustes = json.loads(config.read_text(encoding='utf-8'))
    except FileNotFoundError:
        return 0
    except (OSError, ValueError):
        print('alinear-jale: no se pudo leer alinear-jale.json', file=sys.stderr)
        return 2
    if not isinstance(ajustes, dict) or ajustes.get('activo') is not True:
        return 0

    directorio = Path(os.environ.get('XDG_STATE_HOME') or home / '.local/state') / 'boat-pool/alinear-jale'
    try:
        repo = Path(ajustes.get('repo', home / 'VSCODE/REPOS/SEN-CheckIn')).expanduser().resolve()
        worktree = Path(ajustes.get('worktree', directorio / 'main')).expanduser().resolve()
    except (OSError, RuntimeError, TypeError, ValueError):
        print('alinear-jale: rutas inválidas en alinear-jale.json', file=sys.stderr)
        return 2

    os.umask(0o077)
    try:
        directorio.mkdir(parents=True, exist_ok=True)
        with (directorio / 'pasada.lock').open('a') as candado:
            try:
                fcntl.flock(candado, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            return pasada(directorio, repo, worktree)
    except OSError as error:
        print(ocultar_ids(f'alinear-jale: {error}'), file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
