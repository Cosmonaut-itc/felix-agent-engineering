#!/usr/bin/env python3
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
try:
    from fleet import cli
    code = cli.main()
except KeyboardInterrupt:
    print(json.dumps({"api": "fleet-job-api@1", "operation": "unknown",
                      "error": {"code": "client_interrupted", "effects": "unknown"}}), flush=True)
    code = 130
sys.exit(code)
