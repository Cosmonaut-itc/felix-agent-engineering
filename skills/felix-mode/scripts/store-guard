#!/bin/bash
# Hook PostToolUse: avisa cuando una herramienta toca un store de programa
# (~/.claude/orchestrate/<slug>/) que no tiene units.tsv o decisions.tsv.
# El hook siempre permite continuar, incluso sin sus dependencias.
set -uo pipefail

command -v python3 >/dev/null 2>&1 || exit 0

python3 -c '
import json
import os
import re
import shlex
import sys

try:
    payload = json.load(sys.stdin)
    tool_input = payload.get("tool_input") or {}
    file_path = tool_input.get("file_path")
    command = tool_input.get("command")
    cwd = payload.get("cwd")
    cwd = cwd if isinstance(cwd, str) else ""
except Exception:
    sys.exit(0)

home = os.environ.get("HOME") or os.path.expanduser("~")
root = os.path.join(home, ".claude", "orchestrate")

paths = []
if isinstance(file_path, str):
    paths.append(file_path)
elif isinstance(command, str):
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        tokens = command.split()
    store_path = re.compile(r"(?:~|\$HOME|\$\{HOME\}|" + re.escape(home) + r")(/\.claude/orchestrate/.*)")
    for token in tokens:
        match = store_path.search(token)
        if match:
            paths.append(home + match.group(1))
    if cwd:
        paths.append(cwd)

stores = []
for path in paths:
    try:
        relative = os.path.relpath(os.path.normpath(os.path.join(cwd, os.path.expanduser(path))), root)
    except ValueError:
        continue
    slug = relative.split(os.sep)[0]
    store = os.path.join(root, slug)
    if slug not in (".", "..") and os.path.isdir(store) and store not in stores:
        stores.append(store)

pstack = "<pstack>"
try:
    with open(os.path.join(home, ".claude", "plugins", "installed_plugins.json")) as handle:
        pstack = json.load(handle)["plugins"]["pstack@pstack-claude"][0]["installPath"]
except Exception:
    pass

notes = []
for store in stores:
    missing = [name for name in ("units.tsv", "decisions.tsv") if not os.path.isfile(os.path.join(store, name))]
    if not missing:
        continue
    orch = shlex.quote(os.path.join(pstack, "skills", "poteto-mode", "scripts", "orch", "orch.ts"))
    log = shlex.quote(os.path.join(pstack, "skills", "show-me-your-work", "scripts", "log.sh"))
    trail = shlex.quote(os.path.join(store, "decisions.tsv"))
    steps = []
    if "units.tsv" in missing:
        steps.append(f"bun {orch} --store {shlex.quote(store)} init")
    if "decisions.tsv" in missing:
        steps.append(f"{log} {trail} start <decisión> <por qué> <evidencia> <resultado>")
    absent = " ni ".join(missing)
    notes.append(
        f"El store {store} no tiene {absent}. felix-mode, sección «Programas», exige "
        "units.tsv con una fila por unidad y el trail decisions.tsv de show-me-your-work; no lleves "
        "el estado en un todo.md o un state.md. Corre ahora:\n" + "\n".join(f"- `{step}`" for step in steps)
    )

if notes:
    print(json.dumps({
        "hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": "\n\n".join(notes)},
        "systemMessage": "store-guard: store de programa sin units.tsv o decisions.tsv",
    }, ensure_ascii=False))
'
exit 0
