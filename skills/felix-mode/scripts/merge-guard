#!/bin/bash
set -uo pipefail
command -v python3 >/dev/null 2>&1 || exit 0

python3 -c '
import fnmatch
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tempfile
from urllib.parse import urlparse

REGISTRY = [
    ("*", "CI", pattern) for pattern in (
        ".github/*", ".gitlab-ci.yml", ".circleci/*", ".buildkite/*",
        "azure-pipelines.yml", "bitbucket-pipelines.yml", "Jenkinsfile")
] + [
    ("*", "dependencias", pattern) for pattern in (
        "package.json", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock",
        "pnpm-lock.yaml", "pnpm-workspace.yaml", "bun.lock", "bun.lockb",
        "requirements*.txt", "pyproject.toml", "poetry.lock", "uv.lock",
        "Pipfile", "Pipfile.lock", "Cargo.toml", "Cargo.lock", "go.mod", "go.sum",
        "Gemfile", "Gemfile.lock", "Podfile", "Podfile.lock", "Package.swift",
        "Package.resolved", "composer.json", "composer.lock", "build.gradle",
        "build.gradle.kts", "settings.gradle", "settings.gradle.kts", "libs.versions.toml")
] + [
    ("*", "gobernanza de agentes", pattern) for pattern in (
        "AGENTS.md", "CLAUDE.md", "GEMINI.md", "SKILL.md", ".mcp.json",
        ".claude/*", "*/.claude/*", ".agents/*", "*/.agents/*", ".codex/*", "*/.codex/*")
] + [
    ("Cosmonaut-itc/felix-agent-engineering", "gobernanza de agentes", pattern)
    for pattern in (
        "manifest", "bin/*", "skills/*", "vendor/*", "configs/*",
        "docs/orchestration.md", "docs/agent-routing.md", "docs/native-subagents.md",
        "docs/opencode-workers.md", "docs/t3-delegation.md", "fleet/rack/rack-inspeccionar")
]
NO_HEAD = ("gh pr merge necesita --match-head-commit <head aprobado>, para que GitHub rechace "
           "el merge si el head cambió después de la review. Usa el head que aprobaron "
           "la review y el CI, no el que leas ahora del PR. Procedimiento: references/merge.md de felix-mode.")

CANONICAL = ("Ejecuta el merge en una llamada propia, con valores literales y sin redirecciones, "
             "tuberías, variables ni otros comandos: [cd <dir> &&] gh pr merge <pr> --repo <owner/repo> "
             "--squash --match-head-commit <head aprobado>.")

FORMAT = ("Este comando menciona gh pr merge y merge-guard no puede analizarlo. " + CANONICAL +
          " Si sólo buscas o citas el texto, escríbelo de otra forma, como gh pr merg[e], o pásalo en un archivo.")

CRASH = ("merge-guard falló al revisar este comando, que menciona gh pr merge. Revisa que lleve "
         "el head aprobado y que el PR tenga tu autorización si toca CI, dependencias o gobernanza "
         "de agentes. ¿Lo ejecuto?")

CAUSES = {
    "tren": ("deny", "repo inscrito en el tren: usa pao-tren entregar"),
    "formato": ("deny", "comando bloqueado por formato; el agente debe corregirlo sin tu intervención"),
    "head": ("deny", "merge sin --match-head-commit"),
    "sensible": ("ask", "el PR toca CI, dependencias o gobernanza de agentes"),
    "lectura": ("ask", "no pude comprobar los archivos del PR"),
    "fallo": ("ask", "el hook falló"),
}
mentions = 0


def emit(findings):
    causes = list(dict.fromkeys(cause for cause, _ in findings))
    decision = CAUSES[causes[0]][0]
    labels = [CAUSES[cause][1] for cause in causes]
    message = ("merge-guard: " + "; ".join(labels) if decision == "deny"
               else "merge-guard: necesita la confirmación de Felix porque " + " y ".join(labels))
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
          "permissionDecision": decision,
          "permissionDecisionReason": "\n".join(reason for _, reason in findings)},
          "systemMessage": message}, ensure_ascii=False))


def failed(detail):
    return ("lectura", "No pude comprobar si este PR toca CI, dependencias o gobernanza de agentes "
            f"({detail}). felix-mode pide tu autorización explícita para esos PR. ¿Autorizas este merge?")


def inspect(selector, repo, env, cwd, deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        return failed("tiempo agotado")
    executable = shutil.which("gh", path=env.get("PATH", os.defpath))
    if not executable:
        return failed("gh no disponible")
    args = [executable, "pr", "view"] + ([selector] if selector else [])
    if repo is not None:
        args += ["--repo", repo]
    args += ["--json", "url,files,changedFiles"]
    try:
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as output:
            result = subprocess.run(args, cwd=cwd, env=env, timeout=remaining,
                                    stdout=output, stderr=subprocess.DEVNULL)
            output.seek(0)
            response = output.read()
    except subprocess.TimeoutExpired:
        return failed("tiempo agotado")
    except UnicodeError:
        return failed("respuesta JSON incompleta o inválida")
    except OSError:
        return failed("gh o directorio no disponible")
    if result.returncode:
        return failed("gh pr view falló")
    try:
        data = json.loads(response)
        url, files, count = data["url"], data["files"], data["changedFiles"]
        if not isinstance(url, str) or not isinstance(files, list) or type(count) is not int or count < 0:
            raise ValueError()
        parts = urlparse(url).path.strip("/").split("/")
        if len(parts) < 4 or parts[2] != "pull" or not urlparse(url).netloc:
            raise ValueError()
        owner_repo = "/".join(parts[:2]).lower()
        paths = [item["path"] for item in files]
        if not all(isinstance(path, str) and path for path in paths):
            raise ValueError()
    except (ValueError, KeyError, TypeError):
        return failed("respuesta JSON incompleta o inválida")
    if count > len(files):
        return failed("lista de archivos incompleta")
    categories, matched = [], []
    for path in paths:
        for scope, category, pattern in REGISTRY:
            target = path if "/" in pattern else path.rsplit("/", 1)[-1]
            if (scope == "*" or scope.lower() == owner_repo) and fnmatch.fnmatchcase(target, pattern):
                if category not in categories:
                    categories.append(category)
                if path not in matched:
                    matched.append(path)
    if matched:
        suffix = f" (y {len(matched) - 5} más)" if len(matched) > 5 else ""
        category_text, path_text = ", ".join(categories), ", ".join(matched[:5])
        return ("sensible", f"El PR {url} toca {category_text}: {path_text}{suffix}. "
                "felix-mode lo detiene en merge-ready hasta tu autorización explícita. ¿Autorizas este merge?")
    return None


def literal(raw, cd_argument=False):
    quote = None
    index = 0
    while index < len(raw):
        char = raw[index]
        if quote == "\x27":
            if char == "\x27":
                quote = None
        elif char in "$`":
            return False
        elif char == "\\":
            if index + 1 < len(raw):
                if raw[index + 1] in "$`" or (quote is None and raw[index + 1] in "<>*?[]{}~"):
                    return False
                index += 1
        elif char == quote:
            quote = None
        elif quote is None:
            if char in "\x27\"":
                quote = char
            elif char in "<>*?[]{}~":
                if not (char == "~" and cd_argument and index == 0
                        and (len(raw) == 1 or raw[1] == "/")):
                    return False
        index += 1
    return quote is None


def collect(command, cwd, inherited_env):
    cwd = os.fspath(cwd)
    tokens, doubtful, preceded_by_cd = [], False, False
    word = re.compile(r"(?:[^\s;&|()\"\x27\\]|\\.|\"(?:\\.|[^\"\\])*\"|\x27[^\x27]*\x27)+|[;&|()]+")
    for line in command.split("\n"):
        offset = 0
        while offset < len(line):
            if line[offset].isspace():
                offset += 1
                continue
            if line[offset] == "#":
                break
            match = word.match(line, offset)
            if match is None:
                doubtful = True
                break
            raw = match.group()
            offset = match.end()
            punctuation = all(char in ";&|()" for char in raw)
            try:
                token = raw if punctuation else shlex.split(raw, comments=False, posix=True)[0]
            except (ValueError, IndexError):
                doubtful = True
                break
            tokens.append((token, punctuation, raw))
        tokens.append((";", True, ";"))
    merges, segment, found = [], [], 0
    for token, punctuation, raw in tokens:
        if not punctuation:
            segment.append((token, raw))
            continue
        if token not in {";", "&&"}:
            doubtful = True
        if not segment:
            continue
        is_cd = segment[0][0] == "cd" and len(segment) == 2
        if any(not literal(source, is_cd and index == 1)
               for index, (_, source) in enumerate(segment)):
            doubtful = True
        env = inherited_env.copy()
        if is_cd:
            preceded_by_cd = True
            segment = []
            continue
        while segment and re.match(r"[A-Za-z_][A-Za-z0-9_]*=", segment[0][1]):
            key, value = segment.pop(0)[0].split("=", 1)
            env[key] = value
        segment = [value for value, _ in segment]
        if (len(segment) >= 3 and segment[0].rsplit("/", 1)[-1] == "gh"
                and segment[1:3] == ["pr", "merge"]):
            found += 1
            selector, repo, head, disabled = None, None, None, False
            args, index, unknown = segment[3:], 0, []
            valued = {"--repo", "-R", "--match-head-commit", "--body", "-b",
                      "--body-file", "-F", "--subject", "-t", "--author-email", "-A"}
            boolean = {"--delete-branch", "-d", "--disable-auto",
                       "--merge", "-m", "--rebase", "-r", "--squash", "-s"}
            while index < len(args):
                arg = args[index]
                flag, equal, value = arg.partition("=")
                if arg == "--disable-auto":
                    disabled = True
                if flag in valued:
                    if not equal:
                        value = ""
                        if index + 1 < len(args):
                            index += 1
                            value = args[index]
                    if flag in {"--repo", "-R"}:
                        repo = value
                    elif flag == "--match-head-commit":
                        head = value
                elif arg.startswith("-") and arg not in boolean:
                    unknown.append(arg)
                elif not arg.startswith("-") and selector is None:
                    selector = arg
                index += 1
            if disabled and unknown:
                doubtful = True
            if not disabled:
                if head and preceded_by_cd and not repo:
                    doubtful = True
                merges.append((selector, repo, head, env, cwd, unknown))
        else:
            doubtful = True
        segment = []
    return merges, found, doubtful


def repository(value):
    if not value:
        return None
    value = value.rstrip("/")
    if "://" in value:
        parsed = urlparse(value)
        if not parsed.netloc:
            return None
        value = parsed.path.strip("/")
    elif re.match(r"(?:[^@/]+@)?[^/:]+:", value):
        value = value.split(":", 1)[1]
    elif value.count("/") == 2:
        value = value.split("/", 1)[1]
    match = re.fullmatch(r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)", value)
    return match[1].removesuffix(".git").lower() if match else None


def git_read(directory, args, env, options=()):
    # Missing config and detached HEAD return no value. Transport/read failures
    # stay distinct so an implicit push cannot fall back after a timeout.
    result = subprocess.run(["git", *options, *args], cwd=directory, env=env,
                            text=True, capture_output=True, timeout=2)
    if result.returncode == 0:
        return result.stdout.strip()
    if result.returncode == 1 and args[0] in {"config", "symbolic-ref"}:
        return None
    raise ValueError("lectura de git fallida")


def origin_repo(directory, env):
    return repository(git_read(directory, ["remote", "get-url", "--push", "origin"], env))


def push_to_main(refs, broad, tags_only, read, remote):
    branch = None

    def current():
        nonlocal branch
        if branch is None:
            branch = read(["symbolic-ref", "--short", "HEAD"]) or ""
        if not branch:
            raise ValueError("sin rama actual")
        return branch

    if broad:
        return True
    if not refs and not tags_only:
        configured = read(["config", "--get-all", "remote." + remote + ".push"])
        if configured:
            refs = configured.splitlines()
        else:
            mode = read(["config", "--get", "push.default"]) or "simple"
            if mode == "nothing":
                return False
            if mode == "matching":
                raise ValueError("push.default=matching")
            name = current()
            if mode == "current":
                refs = [name]
            elif mode in {"upstream", "tracking", "simple"}:
                upstream_remote = read(["config", "--get", "branch." + name + ".remote"])
                upstream = read(["config", "--get-all", "branch." + name + ".merge"])
                if upstream and upstream_remote == remote:
                    refs = upstream.splitlines()
                elif mode in {"upstream", "tracking"}:
                    raise ValueError("upstream no resuelto")
                else:
                    refs = [name]
            else:
                raise ValueError("push.default desconocido")
    for ref in refs:
        ref = ref.lstrip("+")
        target = ref.rsplit(":", 1)[-1]
        if ":" not in ref and ref in {"HEAD", "@"}:
            target = current()
        if target == "" or target == ":":
            raise ValueError("refspec sin destino")
        if target in {"main", "refs/heads/main"}:
            return True
        if "*" in target and (fnmatch.fnmatchcase("main", target)
                              or fnmatch.fnmatchcase("refs/heads/main", target)):
            return True
        if "$" in target or "`" in target:
            raise ValueError("refspec dinámico")
    return False


def train_guard(command, directory, inherited_env=None):
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    registry = os.path.join(config, "pao-tren", "inscritos")
    if not os.path.lexists(registry):
        return None
    enrolled, unreadable = set(), False
    try:
        # Check mode bits too: uid 0 must not make a 000 fixture readable.
        if not os.stat(registry).st_mode & 0o444:
            raise OSError("sin permisos de lectura")
        with open(registry, encoding="utf-8") as source:
            enrolled = {line.split("#", 1)[0].strip().lower() for line in source}
        enrolled.discard("")
    except (OSError, UnicodeError):
        unreadable = True
    reason = "repo inscrito en el tren: usa pao-tren entregar"
    unresolved = "No puedo resolver el repo o la ref destino; " + reason
    try:
        tokens = []
        # shlex consumes the newline after a comment. Lex lines separately so
        # cd keeps its own segment even when a comment follows it.
        for line in command.split("\n"):
            lexer = shlex.shlex(line, posix=True, punctuation_chars=";&|()")
            lexer.whitespace_split = True
            tokens.extend(list(lexer) + [";"])
    except ValueError:
        if re.search(r"\b(?:git|gh)\b.*\b(?:push|merge)\b", command, re.S):
            return ("tren", unresolved)
        return None
    segments, segment = [], []
    for token in tokens + [";"]:
        if token and all(char in ";&|()" for char in token):
            segments.append(segment)
            segment = []
        else:
            segment.append(token)
    for args in segments:
        if not args:
            continue
        if args[0] == "cd" and len(args) == 2:
            directory = os.path.abspath(os.path.join(directory, os.path.expanduser(args[1])))
            continue
        env = (inherited_env if inherited_env is not None else os.environ).copy()
        # Recognize env, command and absolute executable paths, conservatively
        # including quoted commands as in the earlier train guard.
        for start, token in enumerate(args):
            if re.match(r"[A-Za-z_][A-Za-z0-9_]*=", token):
                key, value = token.split("=", 1)
                env[key] = value
            tool = token.rsplit("/", 1)[-1]
            if tool in {"bash", "sh", "zsh", "dash", "ksh"}:
                for index in range(start + 1, len(args) - 1):
                    if args[index].startswith("-") and "c" in args[index][1:]:
                        finding = train_guard(args[index + 1], directory, env)
                        if finding:
                            return finding
                        break
            tail = args[start + 1:]
            if tool == "gh" and tail[:2] == ["pr", "merge"]:
                if unreadable:
                    return ("tren", "Registro del tren ilegible; no puedo comprobar la inscripción")
                explicit, selector = None, None
                for index, arg in enumerate(tail[2:], 2):
                    if arg in {"--repo", "-R"} and index + 1 < len(tail):
                        explicit = tail[index + 1]
                    elif arg.startswith("--repo="):
                        explicit = arg.split("=", 1)[1]
                    elif arg.startswith("-R") and len(arg) > 2:
                        explicit = arg[2:]
                    if re.match(r"https?://[^/]+/[^/]+/[^/]+/pull/", arg):
                        selector = "/".join(urlparse(arg).path.strip("/").split("/")[:2])
                try:
                    named = selector or explicit or env.get("GH_REPO")
                    resolved = repository(named) if named else origin_repo(directory, env)
                except (OSError, ValueError, subprocess.TimeoutExpired):
                    resolved = None
                if resolved is None:
                    return ("tren", "No puedo resolver el repo del merge; " + reason)
                if resolved in enrolled:
                    return ("tren", reason)
            if tool != "git":
                continue
            index = 0
            while index < len(tail) and tail[index].startswith("-"):
                flag = tail[index]
                index += 2 if flag in {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env"} else 1
            if tail[index:index + 1] != ["push"]:
                continue
            if unreadable:
                return ("tren", "Registro del tren ilegible; no puedo comprobar la inscripción")
            options, positional, index = tail[:index], [], index + 1
            broad, tags_only, remote, after_options = False, False, None, False
            while index < len(tail):
                arg = tail[index]
                if arg == "--":
                    after_options = True
                elif not after_options and arg in {"--repo", "--receive-pack", "--exec", "-o", "--push-option"}:
                    if index + 1 >= len(tail):
                        return ("tren", unresolved)
                    if arg == "--repo":
                        remote = tail[index + 1]
                    index += 1
                elif not after_options and arg.startswith("--repo="):
                    remote = arg.split("=", 1)[1]
                elif after_options or not arg.startswith("-"):
                    positional.append(arg)
                elif arg in {"--all", "--mirror"}:
                    broad = True
                elif arg == "--tags":
                    tags_only = True
                index += 1
            if remote is None:
                remote = positional.pop(0) if positional else "origin"
            read = lambda args: git_read(directory, args, env, options)
            try:
                if ":" in remote or "/" in remote:
                    destinations = [repository(remote)]
                else:
                    urls = read(["remote", "get-url", "--push", "--all", remote])
                    destinations = [repository(url) for url in (urls or "").splitlines()]
                if not destinations or None in destinations:
                    return ("tren", "No puedo resolver el repo del push; " + reason)
                if not any(repo in enrolled for repo in destinations):
                    continue
                if push_to_main(positional, broad, tags_only, read, remote):
                    return ("tren", reason)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                return ("tren", unresolved)
    return None


def main():
    global mentions
    payload = json.load(sys.stdin)
    command = payload["tool_input"]["command"]
    if not isinstance(command, str):
        return
    command = command.replace("\\\n", "")
    mentions = len(re.findall(r"(?<![\w-])gh\s+pr\s+merge\b", command))
    try:
        train = train_guard(command, payload.get("cwd") or os.getcwd())
    except Exception:
        train = (("tren", "No puedo resolver la regla del tren")
                 if re.search(r"\b(?:push|merge)\b", command) else None)
    def report(findings):
        emit(([train] if train else []) + findings)
    if not mentions:
        if train:
            report([])
        return
    if any(char.isspace() and char not in " \t\n" for char in command):
        report([("formato", FORMAT)])
        return
    merges, found, doubtful = collect(command, payload.get("cwd") or os.getcwd(), os.environ.copy())
    if doubtful or found != mentions or "<<" in command:
        report([("formato", FORMAT)])
        return
    unknown = [("formato", f"gh pr merge lleva un flag que merge-guard no admite: {flags[0]}. " + CANONICAL)
               for *_, flags in merges if flags]
    if unknown:
        report(unknown)
        return
    denials = [("head", NO_HEAD) for _, _, head, _, _, _ in merges if not head]
    if denials:
        report(denials)
        return
    findings = []
    deadline = time.monotonic() + 10
    for selector, repo, _, env, directory, _ in merges:
        finding = inspect(selector, repo, env, directory, deadline)
        if finding:
            findings.append(finding)
    if findings or train:
        report(findings)


try:
    main()
except Exception:
    if mentions:
        emit([("fallo", CRASH)])
' 2>/dev/null || true
exit 0
