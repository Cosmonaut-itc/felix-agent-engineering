#!/bin/bash
# Marca un diff como alto riesgo cuando lo que aterrizaría con squash toca una
# ruta de .agents/high-risk-paths: HEAD, stage, working tree y sin trackear
# frente a la base. Un cambio que la historia de la rama deshace no aterriza.
# Cada línea es una pathspec :(glob) de git relativa a la raíz: * no cruza /,
# y ** sólo vale como segmento entero (**/x, x/**, x/**/y).
set -uo pipefail

LIST=.agents/high-risk-paths
fail() { printf 'risk-classify: %s\n' "$1" >&2; exit 2; }

case "${1:-}" in
    -h|--help) sed -n '2,6s/^# //p' "$0"; printf 'Uso: risk-classify [BASE]\n'; exit 0 ;;
esac
[ "$#" -le 1 ] || fail 'uso: risk-classify [BASE]'

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'no estás en un repositorio git'
cd "$root" || exit 2

if [ ! -f "$LIST" ]; then
    printf 'Rutas: el repositorio no declara %s\n' "$LIST"
    exit 0
fi

base=${1:-}
if [ -z "$base" ]; then
    upstream=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null) || upstream=origin/main
    base=$(git merge-base HEAD "$upstream" 2>/dev/null) ||
        fail "no encuentro la base con $upstream; pásala como argumento"
fi
git rev-parse --verify --quiet "$base^{commit}" >/dev/null || fail "base inválida: $base"

matched=() report=''
number=0
while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    pattern=${line%$'\r'}
    pattern=${pattern#"${pattern%%[![:space:]]*}"}
    pattern=${pattern%"${pattern##*[![:space:]]}"}
    case "$pattern" in ''|'#'*) continue ;; esac
    IFS=/ read -r -a segments <<< "$pattern"
    for segment in "${segments[@]}"; do
        case "$segment" in '**') ;; *'**'*) fail "$LIST:$number: patrón inválido: $pattern" ;; esac
    done
    spec=":(glob)$pattern"
    files=$({ git diff --name-only "$base" HEAD -- "$spec" &&
        git diff --name-only --cached -- "$spec" &&
        git diff --name-only -- "$spec" &&
        git ls-files --others --exclude-standard -- "$spec"; } 2>/dev/null) ||
        fail "$LIST:$number: patrón inválido: $pattern"
    files=$(printf '%s\n' "$files" | sed '/^$/d' | sort -u)
    [ -n "$files" ] || continue
    matched+=("$pattern")
    while IFS= read -r file; do
        report+=$(printf '%s\t%s' "$pattern" "$file")$'\n'
    done <<< "$files"
done < "$LIST"

if [ "${#matched[@]}" = 0 ]; then
    printf 'Rutas: ningún archivo del diff contra %s coincide con %s\n' "$(git rev-parse --short "$base")" "$LIST"
    exit 0
fi
joined=$(printf ', %s' "${matched[@]}")
printf 'Nivel: alto por %s\n%s' "${joined#, }" "$report"
