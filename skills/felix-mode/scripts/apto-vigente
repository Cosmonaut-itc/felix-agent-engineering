#!/bin/bash
# Dice si un APTO sigue vigente cuando el head cambió por incorporar el destino.
# `APTO vigente` confirma una mezcla limpia sin archivos compartidos o una
# excepción de catálogos o Drizzle. Las excepciones comparan rutas por blob y modo.
# Drizzle se detecta en la base común, el head revisado y la base nueva.
# `Ronda` prima ante diferencias no compartidas fuera de los directorios validados, salvo en una mezcla limpia y exacta sin excepción activa.
# `Ronda delta` lista rutas y resolución. Sólo se eximen conflictos en rutas compartidas.
# Sale con 2 si no puede decidir o si la base nueva es ambigua. Requiere git 2.38+ y python3.
set -uo pipefail
fail() { printf 'apto-vigente: %s\n' "$1" >&2; exit 2; }

case "${1:-}" in
    -h|--help) sed -n '2,8s/^# //p' "$0"; printf 'Uso: apto-vigente DESTINO HEAD_REVISADO HEAD_NUEVO\n'; exit 0 ;;
esac
[ "$#" = 3 ] || fail 'uso: apto-vigente DESTINO HEAD_REVISADO HEAD_NUEVO'
commits=()
for ref in "$@"; do
    commit=$(GIT_NO_REPLACE_OBJECTS=1 git rev-parse --verify --quiet "$ref^{commit}") || fail "commit inválido: $ref"
    commits+=("$commit")
done
target=${commits[0]} reviewed=${commits[1]} new=${commits[2]}

# Desde aquí git corre en un repositorio vacío sobre el mismo almacén de
# objetos, con su formato y sus almacenes alternos, y sin las demás variables
# GIT_ heredadas. Un objeto no cambia de contenido sin cambiar de SHA. La
# configuración, refs/replace, info/grafts y shallow del repositorio local sí
# cambian lo que git lee de un SHA, y un push no los publica. Si falta un
# objeto, como en un clon parcial, el script sale con 2.
objects=$(git rev-parse --path-format=absolute --git-path objects) || fail 'no encuentro el almacén de objetos'
format=$(git rev-parse --show-object-format) || fail 'no puedo leer el formato de objetos'
state=${XDG_STATE_HOME:-$HOME/.local/state}/apto-vigente
mkdir -p "$state" || fail 'no puedo crear el directorio de estado'
scratch=$state/$(date -u +%Y%m%dT%H%M%S)-$$
mkdir "$scratch" || fail 'no puedo crear el scratch persistente'
for name in $(compgen -v GIT_); do
    [ "$name" = GIT_ALTERNATE_OBJECT_DIRECTORIES ] || unset "$name"
done
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
git init --quiet --bare --template= --object-format="$format" "$scratch" || fail 'no puedo crear el repositorio temporal'
export GIT_DIR=$scratch GIT_OBJECT_DIRECTORY=$objects

new_base=$(git merge-base --all "$target" "$new") || fail 'el head nuevo no comparte historia con el destino'
[[ "$new_base" != *$'\n'* ]] || fail 'la base común del destino y el head nuevo no es única'
base=$(git merge-base --all "$reviewed" "$new_base") || fail 'el head revisado no comparte historia con la base nueva'
[[ "$base" != *$'\n'* ]] || fail 'la base común del head revisado y la base nueva no es única'

# Con directoryRenames=true git mueve sin conflicto un archivo del parche al
# directorio que el destino renombró, y ninguna de las dos listas lo muestra.
# Con conflictos, el árbol que escribe lleva los marcadores, y su diff contra el
# head nuevo es la resolución.
merge_report=$scratch/merge-report
LC_ALL=C git -c merge.directoryRenames=conflict merge-tree --write-tree --name-only --no-messages -z \
    "$new_base" "$reviewed" > "$merge_report" 2>/dev/null
merge_status=$?
case $merge_status in
    0|1) ;;
    *) fail 'git merge-tree --write-tree falló' ;;
esac
# El veredicto y las excepciones leen los objetos del mismo repositorio aislado.
python3 -I - "$base" "$reviewed" "$new_base" "$new" "$merge_status" "$merge_report" <<'PY_EXCEPTIONS' || fail 'falló el validador de excepciones'
import json
import re
import subprocess
import sys


def unique(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('clave duplicada')
        result[key] = value
    return result


def validate(node):
    if isinstance(node, dict):
        for value in node.values():
            validate(value)
    elif not isinstance(node, str):
        raise ValueError('la traducción no es una cadena')


def git(*args):
    return subprocess.run(['git', *args], check=True, capture_output=True).stdout


def inventory(revision):
    files = {}
    for record in git('ls-tree', '-rtz', '--full-tree', revision).split(b'\0'):
        if record:
            entry, path = record.split(b'\t', 1)
            path = path.decode('utf-8', 'surrogateescape')
            # Las entradas de directorio se conservan sólo si están vacías.
            files.pop(path.rpartition('/')[0], None)
            files[path] = entry
    return files


def load(files, path):
    entry = files.get(path, b'')
    if not entry.startswith(b'100644 blob '):
        raise ValueError(f'{path}: se esperaba un archivo regular sin bit ejecutable')
    return json.loads(git('cat-file', 'blob', entry.split()[-1].decode('ascii')).decode('utf-8'),
                      object_pairs_hook=unique, parse_constant=invalid_constant)


def invalid_constant(value):
    raise ValueError(f'valor JSON inválido: {value}')


def catalogs_disjoint(paths, trees):
    for path in paths:
        if not re.fullmatch(r'(?:.*/)?(?:messages|translations)/[^/]+\.json', path):
            return False
        base, mine, theirs, merged = (load(files, path) for files in trees)
        for node in (base, mine, theirs, merged):
            if not isinstance(node, dict):
                return False
            validate(node)
        if mine == base or theirs == base or union(base, mine, theirs) != merged:
            return False
    return True


def union(base, mine, theirs):
    result = dict(mine)
    for key, value in base.items():
        if key not in mine or key not in theirs:
            raise ValueError('clave borrada')
        if isinstance(value, dict) and isinstance(mine[key], dict) and isinstance(theirs[key], dict):
            result[key] = union(value, mine[key], theirs[key])
        elif mine[key] != value or theirs[key] != value:
            raise ValueError('valor cambiado')
    for key in (mine.keys() & theirs.keys()) - base.keys():
        if not isinstance(mine[key], dict) or not isinstance(theirs[key], dict):
            raise ValueError('altas con clave común')
        if not mine[key] or not theirs[key]:
            raise ValueError('alta de objeto vacío común')
        result[key] = union({}, mine[key], theirs[key])
    result.update({key: value for key, value in theirs.items() if key not in mine})
    return result


JOURNAL = 'meta/_journal.json'
SNAPSHOT = re.compile(r'meta/[^/]+_snapshot\.json')
NUMBERED_SNAPSHOT = re.compile(r'meta/[0-9]{4}_snapshot\.json')
TAG = re.compile(r'[0-9]{4}_[^/\x00]+')
ORIGIN = '00000000-0000-0000-0000-000000000000'
MISSING = object()


def require(condition, message):
    if not condition:
        raise ValueError(message)


def changes(before, after):
    return {path for path in before.keys() | after.keys() if before.get(path) != after.get(path)}


def journal(files):
    data = load(files, 'meta/_journal.json')
    entries = data.pop('entries')
    require(isinstance(entries, list), 'entries no es una lista')
    for entry in entries:
        require(isinstance(entry['tag'], str) and TAG.fullmatch(entry['tag'])
                and type(entry['idx']) is int and type(entry['when']) is int
                and isinstance(entry['version'], str) and type(entry['breakpoints']) is bool,
                'entrada del journal inválida')
        require(0 <= entry['when'] <= 2**53 - 1,
                f"{entry['tag']}: when fuera del rango de enteros seguros")
    require(len({entry['tag'][:4] for entry in entries}) == len(entries),
            'prefijos de migración repetidos')
    return data, entries


def snapshot(files, path):
    data = load(files, path)
    identifier, parent = data.pop('id'), data.pop('prevId')
    require(isinstance(identifier, str) and identifier and isinstance(parent, str),
            f'{path}: id o prevId inválido')
    return identifier, parent, data


def equal(left, right):
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return left.keys() == right.keys() and all(equal(left[key], right[key]) for key in left)
    if isinstance(left, list):
        return len(left) == len(right) and all(equal(a, b) for a, b in zip(left, right))
    return left == right


def merge_schema(original_parent, integrated_parent, original, path):
    if equal(original_parent, original):
        return integrated_parent
    if equal(original_parent, integrated_parent) or equal(integrated_parent, original):
        return original
    if all(isinstance(node, dict) for node in (original_parent, integrated_parent, original)):
        result = {}
        for key in original_parent.keys() | integrated_parent.keys() | original.keys():
            value = merge_schema(original_parent.get(key, MISSING), integrated_parent.get(key, MISSING),
                                 original.get(key, MISSING), f'{path}.{key}')
            if value is not MISSING:
                result[key] = value
        return result
    raise ValueError(f'cambios incompatibles en {path}')


def snapshot_path(tag):
    return f'meta/{tag[:4]}_snapshot.json'


def migration_pairs(trees):
    original_base, reviewed, new_base, new = trees
    point = 2
    try:
        old_header, old_entries = journal(original_base)
        reviewed_header, reviewed_entries = journal(reviewed)
        base_header, base_entries = journal(new_base)
        new_header, new_entries = journal(new)
        require(equal(old_header, reviewed_header)
                and equal(old_entries, reviewed_entries[:len(old_entries)]),
                'el journal revisado modifica su base')
        require(equal(base_header, new_header) and equal(base_entries, new_entries[:len(base_entries)]),
                'el journal nuevo modifica su base')
        old_additions = reviewed_entries[len(old_entries):]
        new_additions = new_entries[len(base_entries):]
        require(old_additions and len(old_additions) == len(new_additions),
                'las altas del journal difieren')
        pairs = []
        idx = base_entries[-1]['idx'] + 1 if base_entries else 0
        when = base_entries[-1]['when'] if base_entries else float('-inf')
        for old, added in zip(old_additions, new_additions):
            old_tag, tag = old['tag'], added['tag']
            require(added['idx'] == idx and tag == f'{idx:04d}{old_tag[4:]}',
                    f'{tag}: idx o tag incorrecto, se esperaba idx {idx} y el sufijo de {old_tag}')
            require(added['when'] > when, f'{tag}: when debe crecer')
            require(equal(old, dict(added, idx=old['idx'], tag=old_tag, when=old['when'])),
                    f'{tag}: versión, breakpoints u otros metadatos cambiaron')
            pairs.append((old_tag, tag))
            idx += 1
            when = added['when']

        point = 3
        before_delta = changes(original_base, reviewed)
        after_delta = changes(new_base, new)
        for old_tag, tag in pairs:
            source, dest = old_tag + '.sql', tag + '.sql'
            entry = reviewed.get(source, b'')
            require(source not in original_base and dest not in new_base
                    and entry.startswith(b'100644 blob ') and new.get(dest) == entry,
                    f'{source} → {dest}: cambió el SQL o pisa un archivo de la base')
            require(source == dest or source not in new, f'{source}: aún existe el nombre anterior')
        require({path for path in before_delta if re.fullmatch(r'[^/]+\.sql', path)}
                == {old + '.sql' for old, _ in pairs}
                and {path for path in after_delta if re.fullmatch(r'[^/]+\.sql', path)}
                == {tag + '.sql' for _, tag in pairs}, 'hay otros cambios de SQL')

        point = 4
        ids = {ORIGIN}
        previous_id, integrated_schema = ORIGIN, {}
        for path in sorted(path for path in new_base if SNAPSHOT.fullmatch(path)):
            require(new.get(path) == new_base[path], f'{path}: snapshot de la base editado')
            identifier, _, schema = snapshot(new_base, path)
            require(identifier not in ids, f'{path}: id repetido en la base nueva')
            ids.add(identifier)
            if NUMBERED_SNAPSHOT.fullmatch(path):
                previous_id, integrated_schema = identifier, schema
        originals = {}
        for old_tag, tag in pairs:
            path = snapshot_path(old_tag)
            new_path = snapshot_path(tag)
            require((path in reviewed) == (new_path in new),
                    f'{path} → {new_path}: cambió la presencia del snapshot')
            if path not in reviewed:
                continue
            require(path not in original_base, f'{path}: el alta pisa un snapshot original de la base')
            identifier, parent, schema = snapshot(reviewed, path)
            require(identifier not in originals and identifier != ORIGIN, f'{path}: id original repetido')
            originals[identifier] = (tag, parent, schema)

        parents = {ORIGIN: {}}
        historical_parents = {parent for _, parent, _ in originals.values()} - originals.keys() - parents.keys()
        for path in original_base:
            if not SNAPSHOT.fullmatch(path):
                continue
            require(reviewed.get(path) == original_base[path], f'{path}: snapshot de la base revisada editado')
            identifier, _, schema = snapshot(reviewed, path)
            require(identifier not in originals, f'{path}: una alta reutiliza el id de la base revisada')
            if identifier in historical_parents:
                require(identifier not in parents, f'{path}: id del padre original repetido')
                parents[identifier] = schema
        require(historical_parents <= parents.keys(), 'falta el snapshot padre original')
        for original_id, (tag, parent, original_schema) in originals.items():
            path = snapshot_path(tag)
            identifier, prev_id, schema = snapshot(new, path)
            require(path not in new_base, f'{path}: el alta pisa un snapshot de la base nueva')
            require(prev_id == previous_id, f'{path}: prevId no apunta al snapshot integrado anterior')
            require(identifier not in ids, f'{path}: id repetido')
            require(parent in parents, f'{path}: el padre original debe preceder al alta')
            expected = merge_schema(parents[parent], integrated_schema, original_schema, path)
            require(equal(schema, expected), f'{path}: el esquema difiere de la mezcla de tres vías')
            parents[original_id] = original_schema
            ids.add(identifier)
            previous_id, integrated_schema = identifier, schema

        point = 5
        for delta, tags in ((before_delta, (old for old, _ in pairs)),
                            (after_delta, (tag for _, tag in pairs))):
            allowed = {'meta/_journal.json'}
            for tag in tags:
                allowed.update((tag + '.sql', snapshot_path(tag)))
            require(delta <= allowed, 'hay otros archivos modificados en el directorio de migraciones')
        return pairs
    except (ValueError, KeyError, TypeError, AttributeError, RecursionError) as error:
        raise ValueError(f'punto {point}: {error}') from error


def compare(trees):
    base, reviewed, target, new = trees
    shared, different = set(), set()
    for path in base.keys() | reviewed.keys() | target.keys() | new.keys():
        original, mine, theirs, candidate = (files.get(path) for files in trees)
        if mine == original:
            reference = theirs
        elif theirs == original or mine == theirs:
            reference = mine
        else:
            shared.add(path)
            continue
        if candidate != reference:
            different.add(path)
    return shared, different


def parent_dirs(path):
    parent = path.rpartition('/')[0]
    while parent:
        yield parent
        parent = parent.rpartition('/')[0]


def emptied_additions(trees):
    base, reviewed, target = ({path for path, entry in files.items()
                               if not entry.startswith(b'040000 tree ')} for files in trees[:3])
    base_dirs = {parent for path in base for parent in parent_dirs(path)}
    additions = {}
    for emptied_side, adding_side in ((reviewed, target), (target, reviewed)):
        emptied = base_dirs - {parent for path in emptied_side for parent in parent_dirs(path)}
        for path in adding_side - base:
            for parent in parent_dirs(path):
                if parent in emptied:
                    additions[path] = parent
                    break
    return additions


def assess(trees, shared, dirs):
    catalogs = {path for path in shared if not path.startswith(dirs)}
    other = {path for path in catalogs if not CATALOG.fullmatch(path)}
    if other:
        return [], f'punto 1: ruta compartida sin excepción: {display_path(min(other))}'
    try:
        valid_catalogs = catalogs_disjoint(catalogs, trees)
    except (ValueError, RecursionError):
        valid_catalogs = False
    if not valid_catalogs:
        return [], 'el head nuevo no es la unión de altas disjuntas'
    movements = []
    try:
        for prefix in dirs:
            local = [{path[len(prefix):]: entry for path, entry in files.items() if path.startswith(prefix)}
                     for files in trees]
            movements.extend(f'{prefix}{old} → {prefix}{tag}' for old, tag in migration_pairs(local))
    except ValueError as error:
        return [], str(error)
    lines = []
    if movements:
        lines.append('Renumeración de Drizzle verificada: ' + ', '.join(movements))
    if catalogs:
        lines.extend(['El catálogo se juntó por claves disjuntas:', *map(display_path, sorted(catalogs))])
    return lines, None


def display_path(path):
    return json.dumps(path) if '\n' in path else path


CATALOG = re.compile(r'(?:.*/)?(?:messages|translations)/[^/]+\.json')
base, reviewed, target, new, merge_status, report_path = sys.argv[1:]
with open(report_path, 'rb') as report:
    auto, *conflicts, terminator = report.read().split(b'\0')
if not re.fullmatch(rb'[0-9a-f]{40}|[0-9a-f]{64}', auto) or terminator:
    raise RuntimeError('informe de mezcla sin árbol o sin separador final')
auto = auto.decode('ascii')
conflicts = {path.decode('utf-8', 'surrogateescape') for path in conflicts if path}
tree = git('rev-parse', new + '^{tree}').decode('ascii').strip()
trees = [inventory(revision) for revision in (base, reviewed, target, tree)]
shared, different = compare(trees)
emptied = emptied_additions(trees)
shared.update(emptied)
different.difference_update(emptied)
migration_dirs = tuple({path[:-len(JOURNAL)] for files in trees[:3] for path in files
                        if path == JOURNAL or path.endswith('/' + JOURNAL)})
dirs = tuple(sorted(prefix for prefix in migration_dirs
                    if any(path.startswith(prefix) for path in shared | different)))
outside = {path for path in different if not path.startswith(dirs)}
has_exception = bool(emptied or dirs or any(CATALOG.fullmatch(path) for path in shared))
unshared_conflicts = conflicts - shared
clean_match = merge_status == '0' and auto == tree
full_round = bool(outside) and (has_exception or not clean_match)
# La regla de mezcla limpia también cuenta las ediciones iguales en ambos lados.
overlap = changes(trees[0], trees[1]) & changes(trees[0], trees[2])
ordinary = clean_match and not overlap and not emptied and not full_round

details, accepted = [], False
if full_round and has_exception:
    prefix = 'Excepción: '
    if dirs:
        prefix = 'Excepción de migraciones: punto 1: '
    elif not emptied:
        prefix = 'Excepción de catálogos: punto 1: '
    details = [prefix + 'el árbol fuera de las migraciones difiere de la referencia: ' + display_path(min(outside))]
elif has_exception and (emptied or unshared_conflicts):
    details = [f'Directorio vaciado: {display_path(emptied[path])}. Archivo añadido: {display_path(path)}'
               for path in sorted(emptied)]
    details.extend(f'Excepción: conflicto de la mezcla en una ruta no compartida: {display_path(path)}'
                   for path in sorted(unshared_conflicts))
elif has_exception and not ordinary:
    details, error = assess(trees, shared, dirs)
    accepted = error is None
    if error:
        label = 'catálogos' if not dirs or not error.startswith('punto ') else 'migraciones'
        details = [f'Excepción de {label}: {error}']

if ordinary or accepted:
    new_short, reviewed_short, target_short = (git('rev-parse', '--short', revision).decode('ascii').strip()
                                               for revision in (new, reviewed, target))
    print(f'APTO vigente: {new_short} es {reviewed_short} más {target_short}, árbol {tree}')
elif full_round or (merge_status == '0' and auto != tree and (not has_exception or not shared)):
    print('Ronda: el head nuevo no es la mezcla del head revisado con el destino')
else:
    reason = ('la mezcla del head revisado con el destino tiene conflictos' if merge_status == '1'
              else 'el destino cambió archivos del parche')
    print(f'Ronda delta: {reason}')
    if merge_status == '1' or auto != tree:
        print(f'Resolución: git diff --no-relative {auto} {new}')
    for path in sorted(conflicts | (shared if has_exception else overlap)):
        print(display_path(path))
for line in details:
    print(line)
PY_EXCEPTIONS
